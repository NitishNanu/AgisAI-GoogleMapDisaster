# ============================================================
# AegisAI Environment Configuration Template
# Copy this to .env and fill in production values
# ============================================================

# Application
PROJECT_NAME="AegisAI - Emergency Response & Digital Twin Platform"
VERSION=1.0.0
DEBUG=false

# Security (CHANGE IN PRODUCTION — min 32 chars)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=disaster_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=30

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# Simulation
SIMULATION_TICK_INTERVAL_SECONDS=10
SIMULATION_AUTO_START=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AI_PER_MINUTE=20
